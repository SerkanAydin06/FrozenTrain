{
  "env": {
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "4000"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git grep*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(Library/**)",
      "Read(Temp/**)",
      "Read(Logs/**)",
      "Read(obj/**)",
      "Read(UserSettings/**)",
      "Read(MemoryCaptures/**)",
      "Read(Build/**)",
      "Read(Builds/**)"
    ]
  }
}
